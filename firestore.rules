rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // HELPERS
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function orgIdOfCaller() {
      return userDoc().data.organizationId;
    }

    function roleOfCaller() {
      return userDoc().data.role;
    }

    function isSameOrg(orgId) {
      // orgId != null matters here: without it, two users who've both
      // signed up but haven't joined/created an org yet both have
      // organizationId == null, and null == null was letting them read
      // each other's full users/{uid} profile doc via the read rule below.
      // Every other caller of isSameOrg() always passes a real org id, so
      // this can't affect any of them.
      return isSignedIn() && orgId != null && orgIdOfCaller() == orgId;
    }

    // The caller must belong to an organisation. Without this, org-less users (organizationId == null) match each
    // other on `null == null` in create rules and could write org-less data or message other org-less users.
    function callerHasOrg() {
      return isSignedIn() && orgIdOfCaller() != null;
    }

    function hasRole(roles) {
      return isSignedIn() && roleOfCaller() in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isAdminOrComplianceOfficer() {
      return hasRole(['admin', 'compliance_officer']);
    }

    // No Cloud Functions / Admin SDK in this build (Spark-plan/free-tier
    // deployment — see SETUP.md). Membership can still only be GRANTED by
    // you, directly in the Firebase console, since there is no client
    // write rule for platformAdmins below — this just lets a signed-in
    // user check their OWN membership so the Admin Console nav item can
    // gate itself.
    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function validRole(r) {
      return r in ['admin', 'compliance_officer', 'analyst', 'user'];
    }

    // Email from the caller's verified ID token. Invitations are keyed by the lower-cased invitee email.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // invitations/{organizationId}_{lower-cased invitee email}: the id embeds the org, so one org can never address
    // (overwrite, list, consume) another org's invitations.
    function invitationPath(orgId) {
      return /databases/$(database)/documents/invitations/$(orgId + '_' + callerEmail());
    }

    function hasEmailClaim() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function hasVerifiedEmail() {
      return hasEmailClaim() && request.auth.token.email_verified == true;
    }

    // Deny everything by default; every collection below explicitly opts in.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // USERS  (users/{uid})
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSameOrg(resource.data.organizationId) || isPlatformAdmin());
      // Self-service profile edits only: display name, photo, notification preferences (never role, org, email, uid...).
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'notificationPrefs']);
      // One-time self-serve bootstrap: a user with no org yet may promote
      // themselves to 'admin' of an org, but only one they just created
      // (createdBy == themselves) — this replaces what the createOrganization
      // Cloud Function used to do with the Admin SDK.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && resource.data.organizationId == null
                    && request.resource.data.role == 'admin'
                    && request.resource.data.organizationId is string
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'organizationId'])
                    && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdBy == request.auth.uid
                    // ...and only within minutes of creating it. Otherwise a founder who was later removed by another
                    // admin could re-promote themselves to admin of that org forever (createdBy never changes).
                    && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdAt > request.time - duration.value(10, 'm');
      // Admins manage roles of members of THEIR org, and may remove a member (org+role -> null). They may NOT
      // change organizationId to anything else: that would let an admin of org A plant a colluding account as
      // admin of any org B. Only role/organizationId may change.
      allow update: if isAdmin() && isSameOrg(resource.data.organizationId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'organizationId'])
                    && ((request.resource.data.organizationId == resource.data.organizationId && validRole(request.resource.data.role))
                        || (request.resource.data.organizationId == null && request.resource.data.role == null));
      // Joining an org by invitation. Only a verified-email user with NO org, only to the org/role of a still-PENDING
      // invitation addressed to their own email, and only in the SAME atomic commit that marks that invitation
      // accepted (getAfter). Because the invitation must be 'pending' beforehand and is 'accepted' afterwards, it is
      // single-use: a removed member cannot rejoin with it, and there is no time window to exploit.
      allow update: if hasVerifiedEmail() && request.auth.uid == uid
                    && resource.data.organizationId == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'organizationId'])
                    && request.resource.data.organizationId is string
                    && validRole(request.resource.data.role)
                    && exists(invitationPath(request.resource.data.organizationId))
                    && get(invitationPath(request.resource.data.organizationId)).data.status == 'pending'
                    && get(invitationPath(request.resource.data.organizationId)).data.email == callerEmail()
                    && get(invitationPath(request.resource.data.organizationId)).data.organizationId == request.resource.data.organizationId
                    && get(invitationPath(request.resource.data.organizationId)).data.role == request.resource.data.role
                    && get(invitationPath(request.resource.data.organizationId)).data.expiresAt > request.time
                    && getAfter(invitationPath(request.resource.data.organizationId)).data.status == 'accepted'
                    && getAfter(invitationPath(request.resource.data.organizationId)).data.acceptedBy == request.auth.uid;
      allow update: if isPlatformAdmin();
      // Profile bootstrap only: the app creates it with role/org null (ensureUserProfile). Without this
      // a new user could create their own doc as 'admin' of ANY organization id.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == null
                    && request.resource.data.organizationId == null;
      allow delete: if isAdmin() && isSameOrg(resource.data.organizationId);
    }

    // ---------------------------------------------------------------
    // ORGANIZATIONS  (organizations/{orgId})
    // ---------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if isSameOrg(orgId) || isPlatformAdmin();
      // Org admins may rename their organisation and nothing else. `plan`/`seats` (billing) and `createdBy`
      // (feeds the bootstrap rule) are never editable by tenant users.
      allow update: if isAdmin() && isSameOrg(orgId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120;
      // Trusted billing path: platform admins (platformAdmins/{uid}) set plan/seats. There is no payment backend;
      // this is an operator action, not a purchase flow.
      allow update: if isPlatformAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'seats'])
                    && request.resource.data.plan in ['starter', 'professional', 'enterprise']
                    && request.resource.data.seats is int && request.resource.data.seats > 0 && request.resource.data.seats <= 1000;
      // New organisations always start on the free tier; nobody can create one with a paid plan or extra seats.
      // The id must be plain alphanumerics (Firestore auto-ids are): invitation ids are `{orgId}_{email}`, so an org id
      // containing '_' could collide with another org's invitation ids.
      allow create: if isSignedIn() && orgId.matches('[A-Za-z0-9]{1,64}')
                    && request.resource.data.keys().hasOnly(['name', 'plan', 'seats', 'createdBy', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
                    && request.resource.data.plan == 'starter' && request.resource.data.seats == 5
                    && request.resource.data.createdAt == request.time;
      allow delete: if false; // never allow client-side org deletion
    }

    // ---------------------------------------------------------------
    // DOCUMENTS  (documents/{docId})
    // ---------------------------------------------------------------
    match /documents/{docId} {
      allow read: if isSameOrg(resource.data.organizationId);
      // ids must be plain [A-Za-z0-9_-]: the app embeds them in inline JS handlers, so a quote/paren in an id would be stored XSS
      allow create: if callerHasOrg() && docId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.organizationId == orgIdOfCaller()
                    && request.resource.data.uploadedBy == request.auth.uid;
      // Any signed-in org member: "New Analysis" (bulk re-analysis) is
      // shown to every member and reanalyzes every document in the org,
      // not just ones that member uploaded — this has to allow that, same
      // reasoning as complianceReports/riskAssessments below.
      allow update: if isSameOrg(resource.data.organizationId)
                    && request.resource.data.organizationId == resource.data.organizationId   // cannot move a document to another org
                    && request.resource.data.uploadedBy == resource.data.uploadedBy
                    && request.resource.data.get('uploadedAt', null) == resource.data.get('uploadedAt', null);
      allow delete: if isAdminOrComplianceOfficer() && isSameOrg(resource.data.organizationId);
    }

    // ---------------------------------------------------------------
    // COMPLIANCE REPORTS  (complianceReports/{reportId})
    // ---------------------------------------------------------------
    match /complianceReports/{reportId} {
      allow read: if isSameOrg(resource.data.organizationId);
      // Any signed-in org member, not just admin/compliance_officer: the UI
      // shows "Generate Report" / "Regenerate with AI" to every member, and
      // in the old Cloud Functions build those wrote via the Admin SDK
      // (bypassing this rule entirely) — this now has to actually match
      // that real behavior since there's no privileged backend left.
      // create and update are separate: the old combined rule let anyone overwrite another org's
      // report by writing their own organizationId into it.
      allow create: if callerHasOrg() && reportId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.organizationId == orgIdOfCaller();
      allow update: if isSameOrg(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isAdmin() && isSameOrg(resource.data.organizationId);
    }

    // ---------------------------------------------------------------
    // COMPLIANCE ISSUES  (complianceIssues/{issueId}) — created client-side
    // from document analysis gaps (no Cloud Functions in this build).
    // Deletion is still never allowed, so the audit trail of what was
    // flagged can't be erased from the client.
    // ---------------------------------------------------------------
    match /complianceIssues/{issueId} {
      allow read: if isSameOrg(resource.data.organizationId);
      allow create: if callerHasOrg() && issueId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.organizationId == orgIdOfCaller();
      // Any signed-in org member: the automatic "resolve stale issues on
      // re-analysis" step in applyAnalysisResult() runs as whichever member
      // triggered the upload/re-analysis, not just elevated roles — same
      // reasoning as complianceReports above. This also loosens the manual
      // "Mark Resolved" button from admin/compliance_officer/analyst-only
      // to any org member, a real (documented) trade-off of this build.
      allow update: if isSameOrg(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.get('documentId', null) == resource.data.get('documentId', null)
                    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
                    // Remediation workflow fields are validated: known status, ISO date, owner must be a member of THIS organisation.
                    && request.resource.data.get('status', 'Open') in ['Open', 'In Progress', 'Resolved']
                    && (request.resource.data.get('dueDate', null) == null
                        || (request.resource.data.dueDate is string && request.resource.data.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
                    && (request.resource.data.get('assigneeId', null) == null
                        || (request.resource.data.assigneeId is string
                            && exists(/databases/$(database)/documents/users/$(request.resource.data.assigneeId))
                            && get(/databases/$(database)/documents/users/$(request.resource.data.assigneeId)).data.get('organizationId', null) == resource.data.organizationId));
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // RISK ASSESSMENTS  (riskAssessments/{riskId})
    // ---------------------------------------------------------------
    match /riskAssessments/{riskId} {
      allow read: if isSameOrg(resource.data.organizationId);
      // Same reasoning as complianceReports: "New Assessment" is shown to
      // every org member in the UI and used to run via Admin-SDK bypass.
      allow create: if callerHasOrg() && riskId.matches('[A-Za-z0-9_-]{1,64}') && request.resource.data.organizationId == orgIdOfCaller();
      allow update: if isSameOrg(resource.data.organizationId) && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if isAdmin() && isSameOrg(resource.data.organizationId);
    }

    // ---------------------------------------------------------------
    // REGULATIONS  (regulations/{regId}) — global read-only reference data,
    // only writable by backend (Cloud Functions using Admin SDK bypass rules)
    // ---------------------------------------------------------------
    match /regulations/{regId} {
      allow read: if isSignedIn();
      // Shared by ALL tenants, so no tenant admin may write it: platform admins only (a doc in
      // platformAdmins/{uid}, created by you in the Firebase console). Org admins and members are read-only.
      allow write: if isPlatformAdmin();
    }

    // ---------------------------------------------------------------
    // NOTIFICATIONS  (notifications/{notifId})
    // ---------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // The recipient may only flip `read`; userId/organizationId/content are immutable (no reassigning or moving).
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Members fan notifications out to their org colleagues (client-side, no backend). The RECIPIENT must be a
      // current member of the caller's own org, so nothing can be sent into another tenant.
      allow create: if callerHasOrg() && notifId.matches('[A-Za-z0-9_-]{1,64}')
                    && request.resource.data.organizationId == orgIdOfCaller()
                    && request.resource.data.userId is string
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
                    && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.organizationId == orgIdOfCaller();
    }

    // ---------------------------------------------------------------
    // INVITATIONS  (invitations/{organizationId}_{lower-cased invitee email})
    // Flow: org admin creates (pending) -> the invitee, with a VERIFIED email, accepts AND joins in one atomic
    // commit (see the users rule) -> the invitation is 'accepted' for good. Org name is denormalised because an
    // invitee cannot read an org they are not in yet.
    // ---------------------------------------------------------------
    function validNewInvitation(inviteId) {
      let d = request.resource.data;
      return isAdmin() && isSameOrg(d.organizationId)
          && d.keys().hasOnly(['email', 'organizationId', 'organizationName', 'role', 'invitedBy', 'status', 'createdAt', 'expiresAt'])
          && d.organizationId is string && d.organizationId.matches('[A-Za-z0-9]{1,64}')
          && d.organizationName is string && d.organizationName.size() <= 200
          && d.email is string && d.email.size() <= 254 && d.email == d.email.lower()
          && d.email.matches('[a-z0-9._%+-]{1,64}@[a-z0-9.-]{1,190}')
          && inviteId == d.organizationId + '_' + d.email
          && validRole(d.role) && d.status == 'pending' && d.invitedBy == request.auth.uid
          && d.createdAt == request.time
          && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(15, 'd');
    }

    match /invitations/{inviteId} {
      allow get: if (hasEmailClaim() && resource.data.email == callerEmail())
                 || (isAdmin() && isSameOrg(resource.data.organizationId));
      // Invitee: only queries constrained to their own email. Admin: only queries constrained to their own org.
      allow list: if (hasEmailClaim() && resource.data.email == callerEmail())
                  || (isAdmin() && isSameOrg(resource.data.organizationId));
      allow create: if validNewInvitation(inviteId);
      // Only the inviting org's admins can re-issue/extend; ids embed the org, so another org cannot reach this doc
      // at all (expired or consumed included).
      allow update: if validNewInvitation(inviteId) && isSameOrg(resource.data.organizationId);
      // Acceptance by the invitee: verified email, still pending and unexpired, touching only
      // status/acceptedBy/acceptedAt, AND in the same atomic commit the invitee joins exactly this org + role.
      allow update: if hasVerifiedEmail() && resource.data.email == callerEmail()
                    && resource.data.status == 'pending' && resource.data.expiresAt > request.time
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.acceptedBy == request.auth.uid
                    && request.resource.data.acceptedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == null
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == resource.data.organizationId
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == resource.data.role;
      allow delete: if isAdmin() && isSameOrg(resource.data.organizationId);
    }

    // ---------------------------------------------------------------
    // CHAT CONVERSATIONS  (chatConversations/{convId}/messages/{msgId})
    // ---------------------------------------------------------------
    match /chatConversations/{convId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      match /messages/{msgId} {
        allow read, create: if isSignedIn() && get(/databases/$(database)/documents/chatConversations/$(convId)).data.userId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // AUDIT LOGS  (auditLogs/{logId}) — written client-side, immutable
    // once created, readable by admins for their own org
    // ---------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin() && isSameOrg(resource.data.organizationId);
      // Shape is pinned: exact key set, bounded strings, status enum, server-assigned timestamp. Forged
      // timestamps / oversized or extra fields are refused. (Still client-written, so not a tamper-proof ledger.)
      allow create: if callerHasOrg()
        && request.resource.data.organizationId == orgIdOfCaller()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['organizationId','actorUid','action','target','status','timestamp'])
        && request.resource.data.keys().hasAll(['organizationId','actorUid','action','target','status','timestamp'])
        && request.resource.data.action is string && request.resource.data.action.size() > 0 && request.resource.data.action.size() <= 200
        && request.resource.data.target is string && request.resource.data.target.size() <= 300
        && request.resource.data.status in ['success','failed','warning','info']
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false; // immutable once written, even from the client
    }

    // ---------------------------------------------------------------
    // PLATFORM ADMINS  (platformAdmins/{uid}) — deliberately has NO
    // client read or write rule, in either direction. Membership can
    // only be granted by YOU, directly in the Firebase console (there is
    // no Admin SDK / Cloud Function in this build either). isPlatformAdmin()
    // above uses exists(), which is allowed to check this path regardless
    // of the rule here — that's what lets the app gate the Admin Console
    // nav item without ever letting a client read or write this collection.
    // See SETUP.md §9 for how to add yourself.
    // ---------------------------------------------------------------
    match /platformAdmins/{uid} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // RATE LIMITS  (rateLimits/{uid}/buckets/{bucket}) — a per-user,
    // client-enforced throttle on Gemini-calling actions (chat, analysis,
    // report generation, etc.), replacing enforceRateLimit() from the old
    // Cloud Functions build. IMPORTANT: because this build has no server,
    // this is a UX throttle, not a real security control — a user who
    // edits their own client can always bypass their own rate-limit doc,
    // just like they could always call the Gemini API directly with the
    // key embedded in this page. The real mitigation for abuse is
    // restricting the Gemini API key itself (HTTP referrer restriction in
    // Google AI Studio / Cloud Console) — see SETUP.md.
    // ---------------------------------------------------------------
    match /rateLimits/{uid}/buckets/{bucket} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------
    // TEAM / INVITES  (organizations/{orgId}/invites/{inviteId})
    // ---------------------------------------------------------------
    match /organizations/{orgId}/invites/{inviteId} {
      // Legacy location (invitations moved to the top-level `invitations` collection). Read/delete only, for cleanup.
      allow read, delete: if isAdmin() && isSameOrg(orgId);
    }
  }
}
